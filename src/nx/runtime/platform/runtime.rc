1 24 "runtime.manifest"
1 ICON "../../../../dist/icons/launcher-normal.ico"
2 ICON "../../../../dist/icons/launcher-dlc.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "YKW4Recomp\0"
            VALUE "ProductName", "YKW4Recomp\0"
            VALUE "OriginalFilename", "YKW4Recomp.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
