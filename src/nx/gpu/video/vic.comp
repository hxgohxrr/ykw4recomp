layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;


struct PlaneDesc {
    uint offset;  
    uint pitch;   
    uint height;
    uint lim;  
    uint blk;  
    uint bh;   
};
struct SlotDesc {
    uint on;
    uint sx0, sy0, dx0, dy0, w, h;
    int mat[12];  
    uint mat_shift, mat_enable;
    uint alpha, clamp_lo, clamp_hi;
    PlaneDesc iy, ic;
};
struct JobDesc {
    uint fmt, sw, sh, nslots;
    PlaneDesc ol, oc;  
};

layout(std430, binding = 0) readonly buffer Params {
    JobDesc job;
    SlotDesc slots[8];
}
ps;
layout(std430, binding = 1) readonly buffer Inputs {
    uint data[];
}
inputs;
layout(std430, binding = 2) buffer OutLuma {
    uint data[];
}
out_luma;
layout(std430, binding = 3) buffer OutChroma {
    uint data[];
}
out_chroma;


const uint TILE_W = 32u, TILE_H = 8u;
const uint WIN_W = 9u;

shared SlotDesc lslots[8];                    
shared uint lmask;                            
shared uint lwin_y[8][TILE_H][WIN_W];         
shared uint lwin_c[8][TILE_H][WIN_W];         


uint plane_off(PlaneDesc p, uint x, uint y) {
    if (p.blk == 0) return y * p.pitch + x;

    uint gob_w = (p.pitch + 63u) / 64u;
    uint bh = 1u << p.bh;
    uint gx = x / 64u, gy = y / 8u;
    uint block_y = gy / bh, gob_in = gy % bh;
    uint off = (block_y * gob_w + gx) * (512u * bh) + gob_in * 512u;
    uint xb = x % 64u, yb = y % 8u;
    off += (xb / 32u) * 256u + (yb / 2u) * 64u + ((xb % 32u) / 16u) * 32u + (yb % 2u) * 16u + (xb % 16u);
    return off;
}


uint fetch_byte(PlaneDesc p, uint x, uint y) {
    uint off = plane_off(p, x, y);
    if (off >= p.lim) return 0u;
    uint word = inputs.data[(p.offset + off) >> 2];
    return (word >> (((p.offset + off) & 3u) * 8u)) & 0xFFu;
}


uint fetch_word(PlaneDesc p, uint x, uint y) {
#ifdef VIC_UNALIGNED

    return fetch_byte(p, x, y) | (fetch_byte(p, x + 1u, y) << 8u) | (fetch_byte(p, x + 2u, y) << 16u) |
           (fetch_byte(p, x + 3u, y) << 24u);
#else

    uint off = plane_off(p, x, y);
    if (off >= p.lim) return 0u;
    uint word = inputs.data[(p.offset + off) >> 2];
    if (off + 4u <= p.lim) return word;
    return word & (0xFFFFFFFFu >> ((4u - (p.lim - off)) * 8u));
#endif
}


uint win_byte(uint word, uint k) { return (word >> ((k & 3u) * 8u)) & 0xFFu; }


uint out_off(PlaneDesc p, uint byte_x, uint y) {
    uint off = plane_off(p, byte_x, y);
    return off < p.lim ? off : 0xFFFFFFFFu;
}

void out_store(uint off, uint value, uint mask, bool chroma) {
    if (off == 0xFFFFFFFFu) return;
#ifdef VIC_UNALIGNED

    for (uint b = 0u; b < 4u; b++) {
        if ((mask & (0xFFu << (b * 8u))) == 0u) continue;
        uint idx = (off + b) >> 2u, sh = ((off + b) & 3u) * 8u;
        if (chroma) {
            atomicAnd(out_chroma.data[idx], ~(0xFFu << sh));
            atomicOr(out_chroma.data[idx], ((value >> (b * 8u)) & 0xFFu) << sh);
        } else {
            atomicAnd(out_luma.data[idx], ~(0xFFu << sh));
            atomicOr(out_luma.data[idx], ((value >> (b * 8u)) & 0xFFu) << sh);
        }
    }
#else
    if ((off & 3u) != 0u) return; 
    uint idx = off >> 2u;
    uint word = chroma ? out_chroma.data[idx] : out_luma.data[idx];
    word = (word & ~mask) | (value & mask);
    if (chroma)
        out_chroma.data[idx] = word;
    else
        out_luma.data[idx] = word;
#endif
}

void main() {
    uint lid = gl_LocalInvocationIndex;
    uint x0 = gl_WorkGroupID.x * TILE_W, y0 = gl_WorkGroupID.y * TILE_H;


    if (lid == 0u) {
        lmask = 0u;
        for (uint s = 0u; s < 8u; s++) {
            SlotDesc sl = ps.slots[s];
            if (sl.on == 0u) continue;
            if (sl.dx0 < x0 + TILE_W && x0 < sl.dx0 + sl.w && sl.dy0 < y0 + TILE_H && y0 < sl.dy0 + sl.h)
                lmask |= 1u << s;
        }
    }
    for (uint s = lid; s < 8u; s += 64u) lslots[s] = ps.slots[s];
    barrier();


    for (uint s = 0u; s < 8u; s++) {
        if ((lmask & (1u << s)) == 0u) continue;
        SlotDesc sl = lslots[s];
        uint cx0 = max(sl.dx0, x0), cx1 = min(sl.dx0 + sl.w, x0 + TILE_W);
        uint cy0 = max(sl.dy0, y0), cy1 = min(sl.dy0 + sl.h, y0 + TILE_H);
        uint sc0 = sl.sx0 + (cx0 - sl.dx0), sr0 = sl.sy0 + (cy0 - sl.dy0);
        uint base = sc0 & ~3u;
        uint w0 = (sc0 - base) >> 2, w1 = (sc0 + (cx1 - cx0) - base + 3u) >> 2;
        for (uint n = lid; n < (cy1 - cy0) * (w1 - w0); n += 64u) {
            uint row = n / (w1 - w0), word = w0 + n % (w1 - w0);
            uint sx = base + word * 4u, sy = sr0 + row;
            lwin_y[s][cy0 - y0 + row][word] = fetch_word(sl.iy, sx, sy);
            lwin_c[s][cy0 - y0 + row][word] = fetch_word(sl.ic, sx, sy >> 1);
        }
    }
    barrier();


    bool nv12 = ps.job.fmt == 0x44u;
    uint px = x0 + gl_LocalInvocationID.x * 4u, py = y0 + gl_LocalInvocationID.y;
    uint luma = 0u, luma_mask = 0u;      
    uint chroma = 0u, chroma_mask = 0u;  
    for (uint i = 0u; i < 4u; i++) {
        if (px + i >= ps.job.sw || py >= ps.job.sh) break;
        bool covered = false;
        uvec4 pix = uvec4(0);  
        for (uint s = 0u; s < 8u; s++) {
            if ((lmask & (1u << s)) == 0u) continue;
            SlotDesc sl = lslots[s];
            if (px + i < sl.dx0 || px + i >= sl.dx0 + sl.w || py < sl.dy0 || py >= sl.dy0 + sl.h) continue;
            uint cx0 = max(sl.dx0, x0);
            uint base = (sl.sx0 + (cx0 - sl.dx0)) & ~3u;
            uint row = py - y0;
            uint sx = sl.sx0 + (px + i - sl.dx0);  
            uint k = sx - base;
            uint kc = (sx & ~1u) - base;  
            uint Y = win_byte(lwin_y[s][row][k >> 2], k);
            uint U = win_byte(lwin_c[s][row][kc >> 2], kc);
            uint V = win_byte(lwin_c[s][row][kc >> 2], kc + 1u);
            ivec4 q = ivec4(int(Y << 2), int(U << 2), int(V << 2), int(sl.alpha));
            if (sl.mat_enable != 0u) {
                int r = q.r * sl.mat[0] + q.g * sl.mat[1] + q.b * sl.mat[2];
                int gr = q.r * sl.mat[4] + q.g * sl.mat[5] + q.b * sl.mat[6];
                int b = q.r * sl.mat[8] + q.g * sl.mat[9] + q.b * sl.mat[10];
                r = ((r >> sl.mat_shift) + sl.mat[3]) >> 8;
                gr = ((gr >> sl.mat_shift) + sl.mat[7]) >> 8;
                b = ((b >> sl.mat_shift) + sl.mat[11]) >> 8;

                int lo = int(sl.clamp_lo), hi = int(sl.clamp_hi);
                q = ivec4(clamp(r, lo, hi), clamp(gr, lo, hi), clamp(b, lo, hi), q.a);
            }
            pix = uvec4(q);
            covered = true;
        }
        if (!covered) continue;

        if (!nv12) {

            bool swap = ps.job.fmt == 0x20u;
            uint r = pix.r >> 2, gg = pix.g >> 2, b = pix.b >> 2, a = pix.a >> 2;
            uint word = swap ? (b | (gg << 8) | (r << 16) | (a << 24)) : (r | (gg << 8) | (b << 16) | (a << 24));
            out_store(out_off(ps.job.ol, (px + i) * 4u, py), word, 0xFFFFFFFFu, false);
        } else {

            luma |= ((pix.r >> 2) & 0xFFu) << (i * 8u);
            luma_mask |= 0xFFu << (i * 8u);

            if ((py & 1u) == 0u && (i & 1u) == 0u) {
                uint j = i;  
                chroma |= (((pix.g >> 2) & 0xFFu) << (j * 8u)) | (((pix.b >> 2) & 0xFFu) << ((j + 1u) * 8u));
                chroma_mask |= (0xFFu << (j * 8u)) | (0xFFu << ((j + 1u) * 8u));
            }
        }
    }
    if (nv12) {
        out_store(out_off(ps.job.ol, px, py), luma, luma_mask, false);
        if ((py & 1u) == 0u && ps.job.oc.lim != 0u)
            out_store(out_off(ps.job.oc, px, py >> 1), chroma, chroma_mask, true);
    }
}
