if(WINDOWS)
    set(module_ext dll)
    set(exe_ext .exe)
else()
    set(module_ext so)
    set(exe_ext "")
endif()
if(NOT GAMES)
    get_filename_component(program_dir "${RUNTIME}" DIRECTORY)
    if(IS_DIRECTORY "${program_dir}/.YKW4Recomp")
        set(data "${program_dir}/.YKW4Recomp")
    elseif(WINDOWS AND DEFINED ENV{APPDATA} AND NOT "$ENV{APPDATA}" STREQUAL "")
        set(data "$ENV{APPDATA}/YKW4Recomp")
    elseif(MACOS AND DEFINED ENV{HOME} AND NOT "$ENV{HOME}" STREQUAL "")
        set(data "$ENV{HOME}/Library/Application Support/YKW4Recomp")
    elseif(NOT WINDOWS AND NOT MACOS AND "$ENV{XDG_DATA_HOME}" MATCHES "^/")  
        set(data "$ENV{XDG_DATA_HOME}/YKW4Recomp")
    elseif(NOT WINDOWS AND NOT MACOS AND DEFINED ENV{HOME} AND NOT "$ENV{HOME}" STREQUAL "")
        set(data "$ENV{HOME}/.local/share/YKW4Recomp")
    else()
        message(STATUS "Runtime not deployed: no home folder to find the games in (set SNX_GAMES_DIR)")
        return()
    endif()
    set(GAMES "${data}/games")
endif()

function(deploy folder game)
    file(COPY_FILE "${RUNTIME}" "${folder}/.${game}.tmp")
    file(CHMOD "${folder}/.${game}.tmp" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE
         WORLD_READ WORLD_EXECUTE)
    file(RENAME "${folder}/.${game}.tmp" "${folder}/${game}${exe_ext}")
    message(STATUS "Runtime deployed to ${folder}/${game}${exe_ext}")
endfunction()
file(GLOB modules "${GAMES}/*_code.${module_ext}")
foreach(module IN LISTS modules)
    get_filename_component(name "${module}" NAME)
    string(REGEX REPLACE "_code\\.${module_ext}$" "" game "${name}")
    deploy("${GAMES}" "${game}")
endforeach()
file(GLOB folders LIST_DIRECTORIES true "${GAMES}/*")
foreach(folder IN LISTS folders)
    get_filename_component(game "${folder}" NAME)
    if(IS_DIRECTORY "${folder}" AND EXISTS "${folder}/${game}_code.${module_ext}")
        deploy("${folder}" "${game}")
    endif()
endforeach()
