{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "default",
      "displayName": "Clang, for this machine",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "windows-cross",
      "displayName": "Windows, cross-built with llvm-mingw",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-clang++",
        "CMAKE_RC_COMPILER": "x86_64-w64-mingw32-windres"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS on Apple silicon, Xcode's Clang (docs/APPLE.md)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_Swift_COMPILER_TARGET": "arm64-apple-macos13.0",
        "SNX_BUILD_GNUABI": "OFF"
      }
    },
    {
      "name": "ios",
      "displayName": "iOS, cross-built on a Mac with Xcode (docs/APPLE.md); LLVM_DIR names scripts/apple-llvm.sh's",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_SYSTEM_PROCESSOR": "arm64",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_Swift_COMPILER_TARGET": "arm64-apple-ios16.0",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_DISABLE_FIND_PACKAGE_SDL3": "ON",
        "SNX_DEPLOY": "OFF",
        "SNX_BUILD_GNUABI": "OFF",
        "SNX_BUILD_3DS": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "launcher-linux",
      "inherits": "default",
      "displayName": "YKW4 Linux desktop launcher",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "SNX_BUILD_GUI": "ON",
        "SNX_BUILD_GNUABI": "OFF",
        "SNX_BUILD_3DS": "OFF",
        "SNX_DEPLOY": "OFF",
        "SNX_EXTRACTED_ONLY": "ON",
        "SNX_YKW4_DISTRIBUTABLE": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "launcher-windows",
      "inherits": "default",
      "displayName": "YKW4 extracted-file Windows launcher",
      "cacheVariables": {
        "SNX_BUILD_GUI": "OFF",
        "SNX_BUILD_GNUABI": "OFF",
        "SNX_BUILD_3DS": "OFF",
        "SNX_DEPLOY": "OFF",
        "SNX_EXTRACTED_ONLY": "ON",
        "SNX_YKW4_DISTRIBUTABLE": "ON",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "launcher-linux", "configurePreset": "launcher-linux" },
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "windows-cross",
      "configurePreset": "windows-cross"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "ios",
      "configurePreset": "ios"
    },
    {
      "name": "launcher-windows",
      "configurePreset": "launcher-windows",
      "targets": [
        "YKW4Recomp",
        "snx-test-launcher-update",
        "snx-test-discord-presence",
        "snx-test-window-icon",
        "snx-test-launcher-name",
        "snx-test-launcher-zip",
        "snx-test-launcher-icon"
      ]
    }
  ]
}
